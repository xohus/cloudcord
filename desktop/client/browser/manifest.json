{
    "manifest_version": 3,
    "minimum_chrome_version": "111",
    "name": "CloudCord Web",
    "description": "The other cutest Discord mod now in your browser",
    "author": "CloudCord",
    "homepage_url": "https://github.com/xohus/cloudcord",
    "icons": {
        "128": "icon.png"
    },
    "host_permissions": [
        "*://*.discord.com/*",
        "https://raw.githubusercontent.com/*"
    ],
    "permissions": [
        "declarativeNetRequest"
    ],
    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": [
                "*://*.discord.com/*"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "run_at": "document_start",
            "matches": [
                "*://*.discord.com/*"
            ],
            "js": [
                "dist/CloudCord.js"
            ],
            "all_frames": true,
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "dist/*",
                "vendor/*"
            ],
            "matches": [
                "*://*.discord.com/*"
            ]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "modifyResponseHeaders",
                "enabled": true,
                "path": "modifyResponseHeaders.json"
            }
        ]
    },
    "background": {
        "service_worker": "service-worker.js"
    },
    "commands": {
        "TOGGLE_MUTE": { "description": "toggle mute" },
        "TOGGLE_DEAFEN": { "description": "toggle deafen" },
        "TOGGLE_VOICE_MODE": { "description": "toggle voice mode" },
        "TOGGLE_STREAMER_MODE": { "description": "toggle streamer mode" },
        "NAVIGATE_BACK": { "description": "navigate back" },
        "NAVIGATE_FORWARD": { "description": "navigate forward" }
    }
}
