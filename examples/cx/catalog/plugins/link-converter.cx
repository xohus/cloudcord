plugin "LinkConverter":
  needs messages.transform
  needs messages.redirectlinks
  needs profile.redirectlinks
  before send rewrite-link "https://reddit.com" with "https://rxddit.com"
  before profile rewrite-link "https://reddit.com" with "https://rxddit.com"
  before send rewrite-link "https://www.reddit.com" with "https://rxddit.com"
  before profile rewrite-link "https://www.reddit.com" with "https://rxddit.com"
  before send rewrite-link "https://old.reddit.com" with "https://rxddit.com"
  before profile rewrite-link "https://old.reddit.com" with "https://rxddit.com"
  before send rewrite-link "https://x.com" with "https://fxtwitter.com"
  before profile rewrite-link "https://x.com" with "https://fxtwitter.com"
  before send rewrite-link "https://www.x.com" with "https://fxtwitter.com"
  before profile rewrite-link "https://www.x.com" with "https://fxtwitter.com"
  before send rewrite-link "https://instagram.com" with "https://vxinstagram.com"
  before profile rewrite-link "https://instagram.com" with "https://vxinstagram.com"
  before send rewrite-link "https://www.instagram.com" with "https://vxinstagram.com"
  before profile rewrite-link "https://www.instagram.com" with "https://vxinstagram.com"
  before send rewrite-link "https://tiktok.com" with "https://tnktok.com"
  before profile rewrite-link "https://tiktok.com" with "https://tnktok.com"
  before send rewrite-link "https://www.tiktok.com" with "https://tnktok.com"
  before profile rewrite-link "https://www.tiktok.com" with "https://tnktok.com"
  before send rewrite-link "https://vm.tiktok.com" with "https://tnktok.com"
  before profile rewrite-link "https://vm.tiktok.com" with "https://tnktok.com"
  before send rewrite-link "https://vt.tiktok.com" with "https://tnktok.com"
  before profile rewrite-link "https://vt.tiktok.com" with "https://tnktok.com"
  before send rewrite-link "https://youtube.com" with "https://yout-ube.com"
  before profile rewrite-link "https://youtube.com" with "https://yout-ube.com"
  before send rewrite-link "https://www.youtube.com" with "https://yout-ube.com"
  before profile rewrite-link "https://www.youtube.com" with "https://yout-ube.com"
  before send rewrite-link "https://m.youtube.com" with "https://yout-ube.com"
  before profile rewrite-link "https://m.youtube.com" with "https://yout-ube.com"
  before send rewrite-link "https://bsky.app" with "https://fxbsky.app"
  before profile rewrite-link "https://bsky.app" with "https://fxbsky.app"
  before send rewrite-link "https://www.bsky.app" with "https://fxbsky.app"
  before profile rewrite-link "https://www.bsky.app" with "https://fxbsky.app"
