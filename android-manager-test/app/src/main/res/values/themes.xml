<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="Theme.AliucordManager.SplashScreen" parent="Theme.SplashScreen">
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cloudcord_mark</item>
    <item name="windowSplashScreenBackground">@color/cloudcord_splash_background</item>
    <item name="postSplashScreenTheme">@style/Theme.AppCompat.NoActionBar</item>

    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
  </style>

  <color name="cloudcord_splash_background">#FFFFFF</color>
  <color name="cloudcord_splash_mark">#000000</color>
</resources>
